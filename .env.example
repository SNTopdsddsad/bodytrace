# Postgres 连接串（云数据库或本地 Docker）
DATABASE_URL=postgresql://user:password@host:5432/bodytrace

# 云数据库外网连接要求 SSL 时设为 require（本地 Docker 不用设）
# DATABASE_SSL=require

# 认证密钥：openssl rand -base64 32 生成，务必修改
BETTER_AUTH_SECRET=

# 应用对外地址（本地开发保持默认即可）
BETTER_AUTH_URL=http://localhost:3000

# 生产反向代理独占写入的真实客户端 IP 头（可选，默认不信任任何 IP 头）
# 仅在代理覆盖客户端同名头、且应用不能绕过代理直连时配置；开发模式忽略此项
# AUTH_TRUSTED_IP_HEADER=x-bodytrace-client-ip

# 每日记录所属时区
APP_TIMEZONE=Asia/Shanghai
