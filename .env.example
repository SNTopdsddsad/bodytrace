# MySQL 连接串；本地 Docker 使用下面的值，云库替换为服务商的地址和账号
# 用户名或密码包含 @、:、/、# 等字符时，先做 URL 编码
DATABASE_URL=mysql://bodytrace:bodytrace@localhost:3307/bodytrace

# 云数据库外网连接要求 SSL 时设为 require（本地 Docker 不用设）
# DATABASE_SSL=require
# 使用服务商提供的 CA 验证服务器证书（可选，默认使用系统信任的 CA）
# DATABASE_SSL_CA_FILE=C:/certificates/mysql-ca.pem

# 认证密钥：openssl rand -base64 32 生成，务必修改
BETTER_AUTH_SECRET=

# 应用对外地址（本地开发保持默认即可）
BETTER_AUTH_URL=http://localhost:3000

# 生产反向代理独占写入的真实客户端 IP 头（可选，默认不信任任何 IP 头）
# 仅在代理覆盖客户端同名头、且应用不能绕过代理直连时配置；开发模式忽略此项
# AUTH_TRUSTED_IP_HEADER=x-bodytrace-client-ip

# 每日记录所属时区
APP_TIMEZONE=Asia/Shanghai

# 阿里云中国站短信服务 SMS：签名须审核通过并完成报备，模板变量固定为 code
# 凭证使用专用 RAM 用户，至少授予 dysms:SendSms；不要填写主账号密钥
# 四项全部配置后开放手机号登录；不配置时仍可使用原邮箱登录
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 使用 STS 临时凭证时填写；长期 AccessKey 留空
# ALIYUN_SECURITY_TOKEN=
# 验证码位数（4–6）、有效分钟数（1–30）、同号重发间隔秒数（1–3600）；均为整数
# 短信模板中的有效期文案须与 SMS_CODE_EXPIRE_MINUTES 一致
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRE_MINUTES=5
SMS_RATE_LIMIT_SECONDS=60
