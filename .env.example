# MySQL 连接串；本地 Docker 使用下面的值，云库替换为服务商的地址和账号
# 用户名或密码包含 @、:、/、# 等字符时，先做 URL 编码
DATABASE_URL=mysql://bodytrace:bodytrace@localhost:3307/bodytrace

# 云数据库外网连接要求 SSL 时设为 require（本地 Docker 不用设）
# DATABASE_SSL=require
# 使用服务商提供的 CA 验证服务器证书（可选，默认使用系统信任的 CA）
# DATABASE_SSL_CA_FILE=C:/certificates/mysql-ca.pem

# 认证密钥：openssl rand -base64 32 生成，务必修改
BETTER_AUTH_SECRET=

# 应用对外地址（本地开发保持默认即可）
BETTER_AUTH_URL=http://localhost:3000

# 生产反向代理独占写入的真实客户端 IP 头（可选，默认不信任任何 IP 头）
# 仅在代理覆盖客户端同名头、且应用不能绕过代理直连时配置；开发模式忽略此项
# AUTH_TRUSTED_IP_HEADER=x-bodytrace-client-ip

# 每日记录所属时区
APP_TIMEZONE=Asia/Shanghai

# 阿里云中国站短信服务 SMS：签名须审核通过并完成报备，模板变量固定为 code
# 凭证使用专用 RAM 用户，至少授予 dysms:SendSms；不要填写主账号密钥
# 四项全部配置后开放手机号登录；不配置时仍可使用原邮箱登录
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 使用 STS 临时凭证时填写；长期 AccessKey 留空
# ALIYUN_SECURITY_TOKEN=
# 验证码位数（4–6）、有效分钟数（1–30）、同号重发间隔秒数（1–3600）；均为整数
# 短信模板中的有效期文案须与 SMS_CODE_EXPIRE_MINUTES 一致
SMS_CODE_LENGTH=6
SMS_CODE_EXPIRE_MINUTES=5
SMS_RATE_LIMIT_SECONDS=60

# 腾讯云 COS：饮食照片存“公有读、私有写”的桶；凭证仅服务端使用，不要加 NEXT_PUBLIC_
# 建议使用子账号，CAM 只授予该前缀的 PutObject / GetObject / DeleteObject / HeadObject
COS_SECRET_ID=
COS_SECRET_KEY=
# 形如 bodytrace-1250000000
COS_BUCKET=
# 形如 ap-guangzhou
COS_REGION=
# 对象 key 前缀，最终路径为 {prefix}/meal-photos/yyyy-MM/{uuid}.webp
COS_UPLOAD_PATH_PREFIX=bodytrace
# 可选：自定义 CDN/访问域名；留空使用 {bucket}.cos.{region}.myqcloud.com
# COS_PUBLIC_BASE_URL=
# 可选：public（默认，桶公有读时直接用对象地址）或 signed（桶私有读时返回签名地址）
# COS_PHOTO_ACCESS=public
# signed 模式下的链接有效期，单位秒，默认 3600
# COS_PHOTO_URL_TTL=3600
